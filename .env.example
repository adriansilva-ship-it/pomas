# Copia este archivo como ".env" y completa los valores.

# Client ID de Google (OAuth 2.0 -> "Aplicación web"). Ver README, sección "Configurar Google".
GOOGLE_CLIENT_ID=

# Correo(s) de los administradores iniciales, separados por coma.
# Estas cuentas entran directo como administrador al iniciar sesión con Google.
ADMIN_EMAILS=director@tucorreo.com

# Opcional: restringir a dominios concretos (vacío = cualquier cuenta Google, el admin aprueba)
ALLOWED_DOMAINS=

# Clave para firmar las sesiones. Si la dejas vacía se genera una y se guarda en server/data/secret.key
SECRET_KEY=

# SOLO PARA PRUEBAS LOCALES (1 = simula Google sin necesitar el Client ID). En producción: 0.
DEV_LOGIN=0

# En producción con HTTPS ponlo en 1
COOKIE_SECURE=0
PORT=5000
MAX_UPLOAD_MB=25
